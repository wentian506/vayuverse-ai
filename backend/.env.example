PYTHON_VERSION=3.11.9
DATABASE_URL=postgresql://postgres.[YOUR-SUPABASE-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
AUTH_SECRET=paste-exact-same-auth-secret-as-vercel
INTERNAL_API_SECRET=paste-exact-same-internal-api-secret-as-vercel
FRONTEND_URL=https://your-project-name.vercel.app
ALLOW_VERCEL_PREVIEWS=true
ENABLE_DEMO_MODE=false

# Optional 100% Free APIs:
GEMINI_API_KEY=
WAQI_API_TOKEN=
