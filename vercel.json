{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/auth/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/v1/**/*.ts": {
      "maxDuration": 60
    }
  }
}
