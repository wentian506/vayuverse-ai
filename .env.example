# =============================================================================
# VAYUVERSE AI — 100% Free-Tier Environment Configuration Template
# Stack: Vercel (Frontend) + Render (FastAPI Backend) + Supabase (PostgreSQL)
#        + Google Cloud Console (Sign in with Google OAuth 2.0)
#
# Local Dev:  copy this file to `.env.local`
# Production: add Frontend keys in Vercel -> Settings -> Environment Variables
#             add Backend keys in Render  -> Environment -> Environment Variables
# NEVER prefix private secrets with NEXT_PUBLIC_!
# =============================================================================

# -----------------------------------------------------------------------------
# A. SHARED SECRETS (ADD IDENTICAL VALUES TO BOTH VERCEL AND RENDER)
# Generate each with:  openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=replace-with-32-byte-random-secret-same-on-vercel-and-render
INTERNAL_API_SECRET=replace-with-32-byte-internal-secret-same-on-vercel-and-render

# -----------------------------------------------------------------------------
# B. VERCEL FRONTEND VARIABLES (Next.js 14)
# -----------------------------------------------------------------------------
# Your deployed Vercel URL (no trailing slash), e.g. https://vayuverse-ai.vercel.app
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Your deployed Render FastAPI URL (no trailing slash), e.g. https://vayuverse-ai-backend.onrender.com
FASTAPI_BACKEND_URL=http://127.0.0.1:8000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://YOUR-PROJECT.vercel.app
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-PROJECT.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keep Demo Mode off (users sign in via Email/Password or Google OAuth)
ENABLE_DEMO_MODE=false

# -----------------------------------------------------------------------------
# C. RENDER BACKEND + SUPABASE DATABASE VARIABLES (FastAPI)
# -----------------------------------------------------------------------------
# Local dev default (SQLite):
DATABASE_URL=sqlite:///./backend/data/vayuverse.db

# Production Supabase Free-Tier (IMPORTANT: use the IPv4 Transaction Pooler port 6543!):
# Supabase Dashboard -> Connect -> Transaction pooler -> URI:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Allowed Vercel Frontend Origin (no trailing slash)
FRONTEND_URL=http://localhost:3000
ALLOW_VERCEL_PREVIEWS=true

# -----------------------------------------------------------------------------
# D. LIVE ENVIRONMENTAL & AI PROVIDERS (ALL 100% FREE TIER)
# -----------------------------------------------------------------------------
# Works automatically out-of-the-box with ZERO API keys:
# - Open-Meteo Air Quality API (Copernicus CAMS global & India pollutants + 72h forecast)
# - Open-Meteo Weather Forecast API (ECMWF / NOAA meteorology)
# - Open-Meteo Geocoding API (Search any city/town in India & worldwide)
# - BigDataCloud & OpenStreetMap Nominatim (Click-anywhere live map reverse geocoding)
# - CARTO / OpenStreetMap Map Tiles (No Google Maps or Mapbox credit card needed)
# - VAYUVERSE Deterministic Grounded AI Engine

# Optional 100% Free-Tier Upgrades (leave blank if not needed):
# Google AI Studio Free API Key (https://aistudio.google.com/apikey) — live Gemini 2.0 Flash AI replies
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# World Air Quality Index Free Token (https://aqicn.org/data-platform/token/) — live CPCB/SPCB station overlay
WAQI_API_TOKEN=
